FROM python:3.11-slim AS builder
WORKDIR /app
COPY pyproject.toml .
COPY src ./src
RUN pip install --no-cache-dir --prefix=/install .

FROM python:3.11-slim
WORKDIR /app
COPY --from=builder /install /usr/local
COPY src ./src
COPY models ./models
EXPOSE 8000
CMD ["uvicorn", "fraud_spike.serving.api:app", "--host", "0.0.0.0", "--port", "8000"]
